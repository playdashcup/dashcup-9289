{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dashcup-9289",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./game-dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://www.dashcup.com",
    "PUBLIC_ORIGIN": "https://www.dashcup.com",
    "GAME_REPLAY_ENABLED": "false",
    "REWARD_EMAIL_DELIVERY_ENABLED": "false"
  },
  "ratelimits": [
    { "name": "API_RATE_LIMIT", "namespace_id": "9289001", "simple": { "limit": 60, "period": 60 } }
  ],
  "routes": [
    { "pattern": "api.dashcup.com", "custom_domain": true },
    { "pattern": "game.dashcup.com", "custom_domain": true }
  ],
  "env": {
    "staging": {
      "name": "dashcup-9289-staging",
      "routes": [],
      "vars": {
        "ENVIRONMENT": "staging",
        "ALLOWED_ORIGINS": "https://staging.dashcup.com",
        "PUBLIC_ORIGIN": "https://staging.dashcup.com",
        "GAME_REPLAY_ENABLED": "false",
        "REWARD_EMAIL_DELIVERY_ENABLED": "false"
      },
      "ratelimits": [
        { "name": "API_RATE_LIMIT", "namespace_id": "9289002", "simple": { "limit": 60, "period": 60 } }
      ]
    }
  }
}
